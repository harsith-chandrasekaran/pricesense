# PriceSense Configuration
# If MySQL variables are omitted or database is unreachable, 
# the system automatically uses the bundled SQLite database at database/pricesense.db

# Flask Server Port
PORT=5001

# MySQL Configuration (Optional)
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=your_mysql_password
# MYSQL_DB=pricesense_db

